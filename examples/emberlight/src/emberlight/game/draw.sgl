;;; (emberlight game draw) - The room, in view pixels, into the current
;;; target.
;;;
;;; The dark is a texture per radius: clear in the middle, a 4x4 Bayer
;;; dithered falloff to the edge, solid beyond it; the rest of the room is
;;; covered with rects. Textures are made on first use and kept (the radius
;;; moves in whole pixels between 14 and 90). The embers are drawn after the
;;; dark, so they glow in it; the moth and the floor under the light before.

(define-library (emberlight game draw)
  (import (sigil math)
          (sigil list)
          (sigil graphics)
          (substratic time tween)
          (substratic text font)
          (emberlight game world))

  (export draw-room! PALETTES)

  (begin
    ;; name -> floor a, floor b, ember core, ember halo, moth, the light's glow
    (define PALETTES
      (list (list 'ember (list 0.36 0.22 0.13) (list 0.30 0.18 0.11) (list 1.0 0.80 0.35) (list 1.0 0.45 0.10) (list 1.0 0.95 0.85) (list 1.0 0.55 0.20))
            (list 'moon  (list 0.16 0.19 0.28) (list 0.13 0.15 0.23) (list 0.85 0.95 1.00) (list 0.35 0.60 1.00) (list 0.92 0.94 1.00) (list 0.35 0.55 1.00))))

    (define (pal name k) (list-ref (cdr (or (assq name PALETTES) (car PALETTES))) k))
    (define (colour! c a) (set-color (car c) (cadr c) (caddr c) a))

    ;; --- the dark ----------------------------------------------------------------

    (define BAYER (vector 0 8 2 10  12 4 14 6  3 11 1 9  15 7 13 5))

    (define *masks* '())                ; ((radius . texture) ...)

    (define (make-mask r)
      (let* ((s (+ (* 2 r) 2))
             (c (/ s 2.0))
             (inner (* r 0.55))
             (bv (make-bytevector (* s s 4) 0)))
        (let rows ((j 0))
          (when (< j s)
            (let cols ((i 0))
              (when (< i s)
                (let* ((dx (- (+ i 0.5) c)) (dy (- (+ j 0.5) c))
                       (d (sqrt (+ (* dx dx) (* dy dy))))
                       (t (cond ((<= d inner) 0.0) ((>= d r) 1.0) (else (/ (- d inner) (- r inner)))))
                       (dark (> (* t 16.0) (+ 0.5 (vector-ref BAYER (+ (* 4 (modulo j 4)) (modulo i 4))))))
                       (k (* 4 (+ (* j s) i))))
                  (bytevector-u8-set! bv (+ k 0) 6)
                  (bytevector-u8-set! bv (+ k 1) 3)
                  (bytevector-u8-set! bv (+ k 2) 3)
                  (bytevector-u8-set! bv (+ k 3) (if dark 255 0)))
                (cols (+ i 1))))
            (rows (+ j 1))))
        (make-texture-from-pixels s s bv 'nearest)))

    (define (mask r)
      (let ((e (assv r *masks*)))
        (if e
            (cdr e)
            (let ((t (make-mask r)))
              (set! *masks* (cons (cons r t) *masks*))
              t))))

    (define (draw-dark! x y r)
      (let* ((s (+ (* 2 r) 2))
             (x0 (- (exact (round x)) (+ r 1)))
             (y0 (- (exact (round y)) (+ r 1))))
        (set-color 0.024 0.012 0.012 1.0)
        (draw-filled-rect 0 0 VIEW-W (max 0 y0))                                    ; above
        (draw-filled-rect 0 (+ y0 s) VIEW-W (max 0 (- VIEW-H (+ y0 s))))            ; below
        (draw-filled-rect 0 y0 (max 0 x0) s)                                        ; left
        (draw-filled-rect (+ x0 s) y0 (max 0 (- VIEW-W (+ x0 s))) s)                ; right
        (set-color 1.0 1.0 1.0 1.0)
        (draw-texture (mask r) x0 y0)))

    ;; --- the pieces ----------------------------------------------------------------

    (define (draw-floor! p)
      (let rows ((ty 0))
        (when (< ty 9)
          (let cols ((tx 0))
            (when (< tx 16)
              (colour! (pal p (if (even? (+ tx ty)) 0 1)) 1.0)
              (draw-filled-rect (* tx 16) (* ty 16) 16 16)
              (cols (+ tx 1))))
          (rows (+ ty 1)))))

    ;; The warm (or cold) glow over the lit floor: a few additive circles,
    ;; the largest faintest, under the dark's dithered edge.
    (define (draw-glow! w p r)
      (let ((x (world-moth-x w)) (y (world-moth-y w)) (c (pal p 5)))
        (with-additive-blend
          (colour! c 0.06) (draw-filled-circle x y (* r 0.95))
          (colour! c 0.07) (draw-filled-circle x y (* r 0.7))
          (colour! c 0.08) (draw-filled-circle x y (* r 0.45))
          (colour! c 0.10) (draw-filled-circle x y (* r 0.22)))))

    (define (draw-moth! w p)
      (let* ((t (world-tick w))
             (x (exact (round (world-moth-x w))))
             (y (+ (exact (round (world-moth-y w))) (exact (round (sin (* t 0.25))))))
             (open (< (modulo t 12) 6)))
        (colour! (pal p 4) 1.0)
        (draw-filled-rect (- x 1) (- y 1) 2 3)                                       ; body
        (if open
            (begin (draw-filled-rect (- x 4) (- y 2) 3 2) (draw-filled-rect (+ x 1) (- y 2) 3 2)
                   (draw-filled-rect (- x 3) y 2 1) (draw-filled-rect (+ x 1) y 2 1))
            (begin (draw-filled-rect (- x 3) (- y 1) 2 2) (draw-filled-rect (+ x 1) (- y 1) 2 2)))))

    (define (draw-ember! e p)
      (let ((x (exact (round (ember-x e)))) (y (exact (round (ember-y e)))))
        (case (ember-state e)
          ((alive)
           (let* ((left (- (ember-life e) (ember-age e)))
                  (flicker (and (< left 60) (< (modulo (ember-age e) 8) 3)))
                  (pulse (+ 0.55 (* 0.45 (sin (* (ember-age e) 0.18))))))
             (unless flicker
               (colour! (pal p 3) (* 0.5 pulse))
               (draw-filled-rect (- x 3) (- y 1) 7 3)
               (draw-filled-rect (- x 2) (- y 2) 5 5)
               (draw-filled-rect (- x 1) (- y 3) 3 7)
               (colour! (pal p 2) 1.0)
               (draw-filled-rect x y 1 1)
               (draw-filled-rect (- x 1) y 1 1)
               (draw-filled-rect x (- y 1) 1 1))))
          ((caught)
           (let ((f (tween-value (ember-fx e) 0.0)))
             (colour! (pal p 2) (- 1.0 f))
             (draw-filled-circle x y (+ 2.0 (* 12.0 f)))))
          (else
           (let ((f (tween-value (ember-fx e) 0.0)))
             (set-color 0.5 0.45 0.4 (* 0.6 (- 1.0 f)))
             (draw-filled-rect x (- y (exact (round (* 6.0 f)))) 1 1))))))

    (define (two n) (if (< n 10) (string-append "0" (number->string n)) (number->string n)))

    (define (centred! text y s)
      (draw-text text (quotient (- VIEW-W (text-width text s)) 2) y s))

    (define (draw-hud! w best)
      (let* ((pop (tween-value (world-pop w) 0.0))
             (s (if (> pop 1.3) 2 1))
             (secs (quotient (+ (world-left w) 59) 60)))
        (set-color 1.0 0.85 0.55 1.0)
        (draw-text (string-append "embers " (number->string (world-caught w))) 4 4 s)
        (set-color 0.9 0.85 0.8 1.0)
        (let ((t (string-append (number->string (quotient secs 60)) ":" (two (modulo secs 60)))))
          (draw-text t (- VIEW-W 4 (text-width t 1)) 4 1))))

    ;; phase screens: the title and the end of a round
    (define (draw-screen! w best line)
      (set-color 0.0 0.0 0.0 0.45)
      (draw-filled-rect 0 0 VIEW-W VIEW-H)
      (set-color 1.0 0.8 0.4 1.0)
      (if (eq? (world-phase w) 'title)
          (begin
            (centred! "emberlight" 36 3)
            (set-color 0.95 0.9 0.85 1.0)
            (centred! "gather the embers before they burn out" 70 1))
          (begin
            (centred! "round over" 36 2)
            (set-color 0.95 0.9 0.85 1.0)
            (centred! (string-append (number->string (world-caught w)) " embers") 62 1)))
      (set-color 0.8 0.75 0.7 1.0)
      (centred! (string-append "best " (number->string best)) 84 1)
      (centred! "space, a or tap to play" 104 1)
      (when line
        (set-color 1.0 0.9 0.6 1.0)
        (centred! line (- VIEW-H 12) 1)))

    ;; The whole room. best: the best score; line: the update line or #f;
    ;; p: the palette's name.
    (define (draw-room! w best line p)
      (set-blend-mode 'normal)
      (draw-floor! p)
      (let ((r (exact (round (tween-value (world-light-shown w) 0.0)))))
        (draw-glow! w p r))
      (draw-moth! w p)
      (draw-dark! (world-moth-x w) (world-moth-y w)
                  (exact (round (tween-value (world-light-shown w) 0.0))))
      (with-additive-blend
        (for-each (lambda (e) (draw-ember! e p)) (world-embers w)))
      (set-blend-mode 'normal)
      (if (eq? (world-phase w) 'play)
          (draw-hud! w best)
          (draw-screen! w best line)))))
