;;; substratic - a small game engine for Sigil
;;;
;;; The pieces a Sigil game needs on the desktop and the web: a pixel view
;;; at whole-number scales, a store and settings, tweens on a fixed clock,
;;; keys and touch sticks, the version.json update check, and playtest
;;; reports. Each is a module, (substratic <area>).

(define sigil-repo "codeberg:sigil/sigil")

(package
  name: "substratic"
  version: "0.2.2"
  sigil: "0.22.7"
  description: "A small game engine for Sigil, on the desktop and the web"
  url: "https://github.com/substratic/substratic"
  license: "BSD-3-Clause"
  authors: (list "David Wilson <david@daviwil.com>")

  configs: (list
    (config
      name: 'dev
      output-dir: "build/dev"
      debug?: #t
      optimize: 0)
    (config
      name: 'release
      output-dir: "build/release"
      debug?: #f
      optimize: 2
      backend: 'native)
    (config
      name: 'web
      output-dir: "build/web"
      toolchain: 'zig
      target: "wasm32-wasi"
      backend: 'native
      debug?: #f
      optimize: 2
      features: '(web wasm graphics)))

  dependencies: (list
    ;; The window, keys and the GL proc loader; native only.
    (from-git url: "codeberg:sigil/sigil-desktop" version: "^0.13.0" configs: '(dev release))
    ;; Drawing, both targets.
    (from-git url: "codeberg:sigil/sigil-graphics" version: ">=0.12.0, <0.14.0")
    ;; Web only: localStorage for (substratic store kv). A game on the web
    ;; lists it too (a dependency's own dependencies are not compiled into
    ;; the game's bundle unless the game lists them, sigil 0.22.7).
    (from-git url: sigil-repo package: "sigil-browser" version: ">=0.22.7" configs: '(web)))

  ;; (substratic image capture): glReadPixels through sigil-desktop's GL proc
  ;; loader natively; (substratic input pad): GLFW's gamepad state. Stubs
  ;; answering #f on the web.
  libraries: (list
    (library
      name: 'substratic
      c-sources: '("src/c/capture.c" "src/c/pad.c" "src/c/natives.c")
      native-init: "sigil__init_substratic_natives"))

  dev-dependencies: (list
    (from-git url: sigil-repo package: "sigil-test" version: ">=0.22.7")
    (from-git url: sigil-repo package: "sigil-test-runner" version: ">=0.22.7")
    ;; the tests check (substratic data json)'s output with an independent decoder
    (from-git url: "codeberg:sigil/sigil-json" version: "^0.16.0"))

  tasks: (list
    (task
      name: 'build
      description: "Build substratic: its C library and its modules"
      steps: (list
        (compile-c-sources
          sources: '("src/c/capture.c" "src/c/pad.c" "src/c/natives.c")
          flags: (with-sigil-c-flags '("-std=c99" "-Wno-unused-parameter")))
        (create-static-library name: "substratic")
        ;; assets/substratic/substratic.js, copied into a dependent's web build
        (link-assets)
        (compile-sigil-modules sources: "src/**/*.sgl"
                               output-dir: (config-output-subdir "lib"))))))
