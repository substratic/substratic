;;; (substratic tasks credentials) - the Cloudflare token and account id.
;;;
;;; From a closed set of two sources, in order:
;;;   1. CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID in the environment
;;;      (both, or it is refused: half a credential is a mistake);
;;;   2. the pass entry substratic.sgv names (credentials: (pass "…")): the
;;;      token on line 1, an "account: <id>" line after it
;;;      (the format the tools expect).
;;;
;;; Four failures of the pass source, each told apart and none printing the
;;; secret: ABSENT (no <store>/<entry>.gpg, pass's own test); LOCKED (the
;;; gpg-agent does not hold the passphrase of the key the nearest .gpg-id
;;; names, read from `gpg-connect-agent 'KEYINFO --list'` field 7 without
;;; raising a pinentry), exit 77 with
;;; how to unlock; FAILED (pass exited non-zero after that check: "locked or
;;; failed", never "absent"); MALFORMED (no token on line 1 or no account
;;; line). Both values must be [A-Za-z0-9_-]+ (they go into curl config
;;; files and URLs).
;;;
;;; The values are returned, never printed. `redact` replaces them in any
;;; text before it is shown.

(define-library (substratic tasks credentials)
  (import (sigil shell prelude) (substratic tasks common) (substratic tasks config))
  (export resolve-credentials
          credential-token
          credential-account
          credential-source
          redact
          credential-env)
  (begin

    (define token-pat "[A-Za-z0-9_-]+")

    (define (make-cred token account source) (list token account source))
    (define (credential-token c) (car c))
    (define (credential-account c) (cadr c))
    (define (credential-source c) (caddr c))

    ;; the environment a child that needs the credential gets (through env:)
    (define (credential-env c)
      (list (cons "CLOUDFLARE_API_TOKEN" (credential-token c))
            (cons "CLOUDFLARE_ACCOUNT_ID" (credential-account c))))

    (define (redact c text)
      (if c
          (string-replace (string-replace text (credential-token c) "<token>")
                          (credential-account c) "<account>")
          text))

    (define (check-values token account where)
      (unless (and (one-line? token) (regex-match? token-pat token))
        (refuse "the token from ~a is not a Cloudflare token (characters outside [A-Za-z0-9_-])" where))
      (unless (and (one-line? account) (regex-match? token-pat account))
        (refuse "the account id from ~a has characters outside [A-Za-z0-9_-]" where)))

    (define (store-dir)
      (let ((d (getenv "PASSWORD_STORE_DIR")))
        (if (and d (not (equal? d ""))) d (expand-home "~/.password-store"))))

    ;; the key ids in the nearest .gpg-id at or above the entry's directory
    (define (recipient-ids store entry)
      (let loop ((d (dirname (path store entry))))
        (let ((f (path d ".gpg-id")))
          (cond ((file? f)
                 (filter (lambda (l) (not (equal? l "")))
                         (map trim (split (read-text f) "\n"))))
                ((or (equal? d store) (equal? d "/") (not (starts-with? d store)))
                 (refuse "no .gpg-id at or above ~a in ~a" entry store))
                (else (loop (dirname d)))))))

    ;; the keygrips of the encryption-capable (sub)keys of KEY-ID
    (define (encryption-keygrips key-id)
      (let ((listing ($? gpg --batch --with-colons --with-keygrip --list-secret-keys ,key-id)))
        (unless (ok? listing)
          (refuse "gpg lists no secret key ~a (the key the password store encrypts to)" key-id))
        (let loop ((ls (split (stdout-of listing) "\n")) (enc #f) (acc '()))
          (if (null? ls)
              (reverse acc)
              (let* ((f (split (car ls) ":"))
                     (type (car f)))
                (cond ((member type '("sec" "ssb"))
                       (loop (cdr ls) (and (>= (length f) 12) (contains? (list-ref f 11) "e")) acc))
                      ((and (equal? type "grp") enc (>= (length f) 10))
                       (loop (cdr ls) #f (cons (list-ref f 9) acc)))
                      (else (loop (cdr ls) enc acc))))))))

    ;; 'unlocked, 'locked, or 'no-passphrase (a key the agent never prompts
    ;; for: type C or T, a smartcard or no passphrase)
    (define (agent-state grips)
      (let ((info ($? gpg-connect-agent "KEYINFO --list" /bye)))
        (unless (ok? info) (refuse "gpg-connect-agent could not list the agent's keys; is the gpg-agent running?"))
        (let ((rows (filter (lambda (f) (and (>= (length f) 7) (equal? (car f) "S") (equal? (cadr f) "KEYINFO")))
                            (map (lambda (l) (filter (lambda (x) (not (equal? x ""))) (split l " ")))
                                 (split (stdout-of info) "\n")))))
          (let ((mine (filter (lambda (f) (member (list-ref f 2) grips)) rows)))
            (cond ((null? mine) 'locked)   ; the agent has not seen the key at all
                  ((any? (lambda (f) (equal? (list-ref f 6) "1")) mine) 'unlocked)
                  ;; a smartcard key (type T) or one with no passphrase (protection C, field 8)
                  ((any? (lambda (f) (or (equal? (list-ref f 3) "T") (and (>= (length f) 8) (equal? (list-ref f 7) "C")))) mine)
                   'no-passphrase)
                  (else 'locked))))))

    (define (any? p xs) (and (pair? xs) (or (p (car xs)) (any? p (cdr xs)))))

    (define (from-pass entry)
      (let* ((store (store-dir))
             (file (path store (str entry ".gpg"))))
        (unless (file? file)
          (refuse "no pass entry ~a (~a does not exist); set CLOUDFLARE_API_TOKEN and CLOUDFLARE_ACCOUNT_ID, or store it there"
                  entry file))
        (let* ((grips (apply append (map encryption-keygrips (recipient-ids store entry))))
               (state (if (null? grips) 'locked (agent-state grips))))
          (when (eq? state 'locked)
            (eprintln "~a: REFUSED: the gpg-agent has not unlocked the key for pass entry ~a." (task-name) entry)
            (eprintln "~a: unlock it in a terminal (`pass show ~a > /dev/null`), then run this again." (task-name) entry)
            (task-exit 77))
          (let ((shown ($? pass show ,entry
                           env: ,(list (cons "PASSWORD_STORE_GPG_OPTS" "--pinentry-mode error"))
                           timeout: 60)))
            (unless (ok? shown)
              ;; never "absent": the file exists. Show only the exit status;
              ;; pass's stderr cannot hold the secret, but nothing is gained
              (refuse "pass show ~a failed (exit ~a): the gpg-agent is locked or gpg failed; unlock it in a terminal (`pass show ~a > /dev/null`)"
                      entry (exit-status shown) entry))
            (let* ((ls (split (stdout-of shown) "\n"))
                   (token (if (pair? ls) (trim (car ls)) ""))
                   (acct-line (let loop ((xs (if (pair? ls) (cdr ls) '())))
                                (cond ((null? xs) #f)
                                      ((starts-with? (car xs) "account:") (car xs))
                                      (else (loop (cdr xs))))))
                   (account (and acct-line (trim (substring acct-line 8 (string-length acct-line))))))
              (when (or (equal? token "") (not account) (equal? account ""))
                (refuse "pass entry ~a is malformed: want the token on line 1 and an \"account: <id>\" line" entry))
              (check-values token account (str "pass " entry))
              (make-cred token account 'pass))))))

    ;; CONFIG's credential, or a refusal. Never prints either value.
    (define (resolve-credentials config)
      (let ((t (getenv "CLOUDFLARE_API_TOKEN"))
            (a (getenv "CLOUDFLARE_ACCOUNT_ID")))
        (cond ((and t (not (equal? t "")))
               (unless (and a (not (equal? a "")))
                 (refuse "CLOUDFLARE_API_TOKEN is set but CLOUDFLARE_ACCOUNT_ID is not"))
               (check-values t a "the environment")
               (say "credentials from the environment (every child this task starts inherits them)")
               (make-cred t a 'env))
              ((and a (not (equal? a "")))
               (refuse "CLOUDFLARE_ACCOUNT_ID is set but CLOUDFLARE_API_TOKEN is not"))
              (else (from-pass (pass-entry config))))))))
