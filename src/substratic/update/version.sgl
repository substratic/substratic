;;; (substratic update version) - version.json, and comparing versions.
;;;
;;; A game's site publishes /version.json beside the game, generated at
;;; publish time from the tree being published, and served uncached:
;;;
;;;   {"version": "0.1.2", "date": "2026-09-25", "stamp": "a1b2c3d4e5f6",
;;;    "summary": "One line about the release.", "news": "https://.../news/0-1-2/"}
;;;
;;; Only "version" is required; the rest may be missing. Versions compare
;;; part by part as numbers ("0.1.10" is newer than "0.1.9").

(define-library (substratic update version)
  (import (sigil struct)
          (sigil string)
          (sigil list)
          (substratic data json))

  (export version-info version-info? version-info-version version-info-date
          version-info-stamp version-info-summary version-info-news
          parse-version-info version-compare)

  (begin
    (define-struct version-info
      (version default: "")
      (date default: #f)
      (stamp default: #f)
      (summary default: #f)
      (news default: #f))

    (define (string-field d name)
      (let ((v (guard (e (#t #f)) (json-ref d name))))
        (and (string? v) (> (string-length v) 0) v)))

    ;; version.json's text -> a version-info, or #f (not JSON, not an
    ;; object, no string "version").
    (define (parse-version-info text)
      (and (string? text)
           (let ((d (guard (e (#t #f)) (json->datum text))))
             (and (pair? d)
                  (let ((v (string-field d 'version)))
                    (and v
                         (version-info version: v
                                       date: (string-field d 'date)
                                       stamp: (string-field d 'stamp)
                                       summary: (string-field d 'summary)
                                       news: (string-field d 'news))))))))

    ;; --- comparing versions --------------------------------------------------

    ;; A part as (number . tag): "10" -> (10 . ""), "0-rc1" -> (0 . "-rc1"),
    ;; "beta" -> (#f . "beta").
    (define (part-split p)
      (let loop ((i 0))
        (if (and (< i (string-length p)) (char-numeric? (string-ref p i)))
            (loop (+ i 1))
            (cons (and (> i 0) (string->number (substring p 0 i)))
                  (substring p i (string-length p))))))

    (define (version-parts v)
      (map part-split (string-split v ".")))

    ;; The numbers first; at equal numbers a plain part is newer than a
    ;; tagged one ("1.0.0" > "1.0.0-rc1"), and two tags compare as text.
    (define (part-compare a b)
      (let ((na (or (car a) -1)) (nb (or (car b) -1)) (ta (cdr a)) (tb (cdr b)))
        (cond ((< na nb) -1)
              ((> na nb) 1)
              ((and (string=? ta "") (not (string=? tb ""))) 1)
              ((and (string=? tb "") (not (string=? ta ""))) -1)
              ((string<? ta tb) -1)
              ((string<? tb ta) 1)
              (else 0))))

    ;; -1, 0 or 1 as a is older than, the same as, or newer than b. Missing
    ;; trailing parts count as 0 ("0.2" = "0.2.0").
    (define (version-compare a b)
      (let loop ((pa (version-parts a)) (pb (version-parts b)))
        (cond ((and (null? pa) (null? pb)) 0)
              (else
               (let ((c (part-compare (if (null? pa) (cons 0 "") (car pa)) (if (null? pb) (cons 0 "") (car pb)))))
                 (if (= c 0)
                     (loop (if (null? pa) '() (cdr pa)) (if (null? pb) '() (cdr pb)))
                     c))))))))
