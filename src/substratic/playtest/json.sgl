;;; (substratic playtest json) - Any datum as JSON text, for report.json.
;;;
;;; An alist (every element a pair with a symbol or string key) is an
;;; object, another list or a vector an array, a dotted pair a two-element
;;; array, a symbol or char a string, a non-finite number null, the symbol
;;; null null; anything else (a record, a procedure) its written form, as a
;;; string. Written here rather than by sigil-json's encoder because a
;;; report's datums come from the game, and the mapping has to be the same
;;; for every shape the game hands over.

(define-library (substratic playtest json)
  (import (sigil math)
          (sigil string)
          (sigil io)
          (sigil json))

  (export datum->json)

  (begin
    (define (written d) (with-output-to-string (lambda () (write d))))

    (define (json-key k)
      (json-encode (if (symbol? k) (symbol->string k) (if (string? k) k (written k)))))

    (define (object-like? d)
      (and (pair? d) (list? d)
           (let loop ((l d))
             (or (null? l)
                 (and (pair? (car l))
                      (or (symbol? (caar l)) (string? (caar l)))
                      (loop (cdr l)))))))

    (define (finite-number? x)
      (and (= x x) (< (abs x) 1e300)))

    ;; Any datum as JSON text, mapped as above.
    (define (datum->json d)
      (cond ((string? d) (json-encode d))
            ((eq? d #t) "true")
            ((eq? d #f) "false")
            ((eq? d 'null) "null")
            ((number? d)
             (cond ((exact-integer? d) (number->string d))
                   ((finite-number? (inexact d)) (json-encode (inexact d)))
                   (else "null")))
            ((symbol? d) (json-encode (symbol->string d)))
            ((char? d) (json-encode (string d)))
            ((null? d) "[]")
            ((vector? d) (datum->json (vector->list d)))
            ((object-like? d)
             (string-append "{"
                            (string-join (map (lambda (e) (string-append (json-key (car e)) ":" (datum->json (cdr e)))) d) ",")
                            "}"))
            ((list? d) (string-append "[" (string-join (map datum->json d) ",") "]"))
            ((pair? d) (string-append "[" (datum->json (car d)) "," (datum->json (cdr d)) "]"))
            (else (json-encode (written d)))))))
