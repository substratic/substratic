;;; (substratic store kv) - Where a save lives on each target.
;;;
;;; Extracted from Crash The Stack's (crash store), by way of Harkfell's
;;; copy, which added set-store-app! so the module names no game.
;;;
;;; One interface, two backends, picked at the import: on the web, the
;;; browser's localStorage through (sigil browser local-storage); natively,
;;; one file per key under the user's data directory
;;; ($XDG_DATA_HOME/<app>, or ~/.local/share/<app>, <app> as given to
;;; set-store-app!), which a gate points elsewhere with set-store-root!.
;;; Keys are short names; values are text. store-read-datum and
;;; store-write-datum! carry an s-expression through.
;;;
;;; Nothing here raises: a missing key is #f, a failed write is #f (the
;;; shell may say so in the HUD), and a save that does not read back as
;;; one datum is #f. Each verb is one define per target, inside the
;;; cond-expand.

(define-library (substratic store kv)
  (cond-expand
    (wasm (import (sigil io)
                  (sigil browser local-storage)))
    (else (import (sigil io)
                  (sigil fs)
                  (sigil process))))

  (export store-root set-store-root! set-store-app! set-store-prefix!
          store-get store-set! store-remove!
          store-read-datum store-write-datum!
          datum->text text->datum)

  (begin
    ;; Native only: the directory the files live in. #f until first use.
    (define *root* #f)

    ;; The data directory's name under the user data directory (native),
    ;; set by the game before the first store call.
    (define *app* "sigil-game")

    ;; Web only: a prefix for every localStorage key. Pages on one origin
    ;; share one localStorage, so two games there (site/a and site/b) would
    ;; share "settings-version" and "update-seen" without one. Off by
    ;; default, because a game that already has players keeps its keys where
    ;; they are: turning a prefix on moves every key, and old saves with it.
    (define *prefix* "")
    (define (set-store-prefix! p) (set! *prefix* p))

    (define (set-store-app! name)
      (set! *app* name)
      (set! *root* #f))

    (define (store-root)
      (or *root*
          (begin (set! *root* (default-root)) *root*)))

    (define (set-store-root! path)
      (set! *root* path))

    (define (key-path key)
      (string-append (store-root) "/" key ".sgl"))

    ;; --- the root and the three verbs, per target ---------------------------

    (cond-expand
      (wasm
       (define (default-root)
         "localStorage")

       (define (store-get key)
         (guard (e (else #f))
           (local-storage-get (string-append *prefix* key))))

       (define (store-set! key text)
         (guard (e (else #f))
           (local-storage-set! (string-append *prefix* key) text)))

       (define (store-remove! key)
         (guard (e (else #f))
           (local-storage-remove! (string-append *prefix* key)))))

      (else
       ;; The user data directory, by the first variable set: XDG_DATA_HOME
       ;; (Linux, and any test that points it at a scratch directory),
       ;; APPDATA (Windows: %APPDATA% is the Roaming profile; real Windows
       ;; sets neither XDG_DATA_HOME nor HOME, so without this step the
       ;; store falls to the current directory there), then ~/.local/share,
       ;; then the current directory. Anything else that keeps files beside
       ;; the store (the playtest reports) resolves its directory from
       ;; store-root.
       (define (default-root)
         (let ((xdg (getenv "XDG_DATA_HOME"))
               (appdata (getenv "APPDATA"))
               (home (getenv "HOME")))
           (string-append (cond ((and xdg (> (string-length xdg) 0)) xdg)
                                ((and appdata (> (string-length appdata) 0)) appdata)
                                (home (string-append home "/.local/share"))
                                (else "."))
                          (string-append "/" *app*))))

       (define (store-get key)
         (guard (e (else #f))
           (read-file-string (key-path key) missing: #f)))

       (define (store-set! key text)
         (guard (e (else #f))
           (ensure-directory (store-root))
           (write-file-string (key-path key) text)
           #t))

       (define (store-remove! key)
         (guard (e (else #f))
           (when (file-exists? (key-path key))
             (delete-file (key-path key)))
           #t))))

    ;; --- datums ------------------------------------------------------------------

    (define (datum->text d)
      (with-output-to-string (lambda () (write d))))

    ;; The one datum in the text, or #f for anything else (empty, more than
    ;; one, unreadable).
    (define (text->datum text)
      (and (string? text)
           (guard (e (else #f))
             (let* ((port (open-input-string text))
                    (d (read port))
                    (more (read port)))
               (and (not (eof-object? d))
                    (eof-object? more)
                    d)))))

    (define (store-read-datum key)
      (text->datum (store-get key)))

    (define (store-write-datum! key d)
      (store-set! key (datum->text d)))))
