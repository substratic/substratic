;;; (substratic update version, check): version.json parsing, the version comparison, and
;;; the status on each platform, including the once-per-version line
;;; through the store.

(import (sigil test)
        (sigil time)
        (substratic store kv)
        (substratic update version)
        (substratic update check))

(define FULL "{\"version\":\"0.1.2\",\"date\":\"2026-09-25\",\"stamp\":\"a1b2c3d4e5f6\",\"summary\":\"Moths at the start.\",\"news\":\"https://example.org/news/0-1-2/\"}")

(test-group "update: parsing version.json"
  (test "every field"
    (let ((i (parse-version-info FULL)))
      (assert-equal "0.1.2" (version-info-version i))
      (assert-equal "2026-09-25" (version-info-date i))
      (assert-equal "a1b2c3d4e5f6" (version-info-stamp i))
      (assert-equal "Moths at the start." (version-info-summary i))
      (assert-equal "https://example.org/news/0-1-2/" (version-info-news i))))
  (test "only the version is required"
    (let ((i (parse-version-info "{\"version\":\"1.0\"}")))
      (assert-equal "1.0" (version-info-version i))
      (assert-false (version-info-summary i))))
  (test "anything else is #f, never an error"
    (assert-false (parse-version-info ""))
    (assert-false (parse-version-info "<html>404</html>"))
    (assert-false (parse-version-info "[1,2]"))
    (assert-false (parse-version-info "\"0.1.2\""))
    (assert-false (parse-version-info "{\"version\":12}"))
    (assert-false (parse-version-info "{\"summary\":\"no version\"}"))
    (assert-false (parse-version-info #f))))

(test-group "update: comparing versions"
  (test "numbers compare as numbers, not text"
    (assert-equal 1 (version-compare "0.1.10" "0.1.9"))
    (assert-equal -1 (version-compare "0.1.9" "0.1.10")))
  (test "equal, and missing parts are zero"
    (assert-equal 0 (version-compare "0.2.0" "0.2.0"))
    (assert-equal 0 (version-compare "0.2" "0.2.0")))
  (test "a release is newer than its tagged pre-release"
    (assert-equal 1 (version-compare "1.0.0" "1.0.0-rc1"))))

(define root (string-append "/tmp/substratic-test-update-" (number->string (current-jiffy))))

(test-group "update: the desktop compares"
  (test "a newer version is 'waiting, with a line naming it"
    (let ((u (make-updater "0.1.1" 'desktop)))
      (updater-set-info! u FULL)
      (assert-equal 'waiting (updater-status u "0.1.1"))
      (assert-equal "Version 0.1.2 is out: https://example.org/news/0-1-2/" (updater-line u 'waiting))))
  (test "the same or an older version is not"
    (let ((u (make-updater "0.1.2" 'desktop)))
      (updater-set-info! u FULL)
      (assert-equal 'none (updater-status u "0.1.2")))
    (let ((u (make-updater "0.2.0" 'desktop)))
      (updater-set-info! u FULL)
      (assert-equal 'none (updater-status u "0.2.0"))))
  (test "no file, or a bad one, is 'none"
    (let ((u (make-updater "0.1.1" 'desktop)))
      (assert-equal 'none (updater-status u "0.1.1"))
      (assert-false (updater-set-info! u "not json"))
      (assert-equal 'none (updater-status u "0.1.1")))))

(test-group "update: the web's worker decides 'waiting"
  (test "a newer version.json alone is not 'waiting on the web"
    (let ((u (make-updater "0.1.1" 'web)))
      (updater-dispatch! u "update-info" FULL)
      (assert-equal 'none (updater-status u "0.1.1"))))
  (test "the worker's word is, and the line names the version"
    (let ((u (make-updater "0.1.1" 'web)))
      (assert-true (updater-dispatch! u "update-info" FULL))
      (assert-true (updater-dispatch! u "update" "waiting"))
      (assert-false (updater-dispatch! u "keydown" "a"))
      (assert-equal 'waiting (updater-status u "0.1.1"))
      (assert-equal "A new version is ready (0.1.2). Reload to play it." (updater-line u 'waiting)))))

(test-group "update: new in this version, once"
  (test "the first launch ever shows nothing, and records the version"
    (set-store-root! (string-append root "-first"))
    (let ((u (make-updater "0.1.2" 'web)))
      (updater-set-info! u FULL)
      (assert-false (updater-last-seen))
      (assert-equal 'none (updater-status u (updater-last-seen)))
      (updater-mark-seen! u)
      (assert-equal "0.1.2" (updater-last-seen))))
  (test "the first launch after an update shows the summary, then never again"
    (set-store-root! (string-append root "-after"))
    (store-write-datum! SEEN-KEY "0.1.1")
    (let ((u (make-updater "0.1.2" 'desktop)))
      (updater-set-info! u FULL)
      (assert-equal 'new-in (updater-status u (updater-last-seen)))
      (assert-equal "New in 0.1.2: Moths at the start." (updater-line u 'new-in))
      (updater-mark-seen! u)
      (assert-equal 'none (updater-status u (updater-last-seen)))))
  (test "no summary for the running version means no line"
    (let ((u (make-updater "0.1.2" 'desktop)))
      (updater-set-info! u "{\"version\":\"0.1.2\"}")
      (assert-equal 'none (updater-status u "0.1.1"))))
  (test "'waiting wins over 'new-in"
    (let ((u (make-updater "0.1.2" 'web)))
      (updater-set-info! u FULL)
      (updater-set-waiting! u #t)
      (assert-equal 'waiting (updater-status u "0.1.1")))))
